# Copy to .env.local and fill in values:
#   copy .env.example.local .env.local

APP_ENV=local
NODE_ENV=development

HOST=0.0.0.0
PORT=5050
TCP_HOST=0.0.0.0
TCP_PORT=2026

CORS_ORIGIN=http://localhost:5050,http://127.0.0.1:5050
JWT_SECRET=local-dev-secret-change-me

EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=!0 Connection Alert

# Dashboard implant builder defaults
BUILD_C2_HOST=127.0.0.1
BUILD_C2_PORT=2026
