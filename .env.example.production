# Copy to .env.production and fill in values:
#   copy .env.example.production .env.production

APP_ENV=production
NODE_ENV=production

HOST=0.0.0.0
PORT=5000
TCP_HOST=0.0.0.0
TCP_PORT=443

CORS_ORIGIN=https://your-domain.com
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=!0 Connection Alert

# Dashboard implant builder defaults (set to your public C2)
BUILD_C2_HOST=
BUILD_C2_PORT=443
