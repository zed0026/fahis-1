# Copy to .env.production and fill in values:
#   copy .env.example.production .env.production

APP_ENV=production
NODE_ENV=production

HOST=0.0.0.0
PORT=5000
TCP_HOST=0.0.0.0
TCP_PORT=443

CORS_ORIGIN=https://your-domain.com
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=!0 Connection Alert

# Dashboard implant builder — MUST match where implants can reach this server
# Use your VPS public IP or DNS name (not 127.0.0.1)
BUILD_C2_HOST=your-vps.example.com
PUBLIC_C2_HOST=
# Usually same as implant TCP listener (see server log: [C2] Implant TCP bind …)
# If HTTP PORT equals TCP_PORT, listener falls back to 2026 — set BUILD_C2_PORT=2026 then
BUILD_C2_PORT=443
